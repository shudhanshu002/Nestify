PORT=5000
MONGODB_URI=your_mongodb_connection_string
JWT_SECRET=your_jwt_secret
NODE_ENV=development

# CLOUDINARY CONFIGURATION
CLOUDINARY_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# GOOGLE OAUTH
CLIENT_ID_GOOGLE=your_google_client_id

# EMAIL OTP CONFIGURATION (Optional for dev, required for real emails)
# If using Gmail, generate an App Password: Google Account -> Security -> 2-Step Verification -> App Passwords
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_digit_app_password
EMAIL_FROM="Nestify Support" <your_email@gmail.com>
# Optional custom SMTP host and port (defaults to Gmail):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# ======================================================================
# REAL-TIME SMS OTP CONFIGURATION (Choose ANY ONE free provider below)
# ======================================================================

# OPTION 1: Fast2SMS (Recommended for India - Free credits on signup)
# Sign up at: https://www.fast2sms.com -> Dev API
# FAST2SMS_API_KEY=your_fast2sms_api_key_here

# OPTION 2: 2Factor.in (Specialized Indian OTP Gateway - Free trial credits)
# Sign up at: https://2factor.in
# TWOFACTOR_API_KEY=your_2factor_api_key_here

# OPTION 3: Twilio (Global Telecom Provider - $15 Free trial balance)
# Sign up at: https://www.twilio.com
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=+1234567890
